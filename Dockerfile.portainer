FROM python:3.10-slim

WORKDIR /app
RUN apt-get update && apt-get install -y git

# Clone repository
RUN git clone https://github.com/canvrno/ProxmoxMCP.git . 

# Install dependencies
RUN pip install uv && \
    uv venv && \
    . .venv/bin/activate && \
    uv pip install -e ".[dev]"

# Create config directory
RUN mkdir -p /app/proxmox-config

EXPOSE 8000
CMD ["python", "-m", "proxmox_mcp.server"]
